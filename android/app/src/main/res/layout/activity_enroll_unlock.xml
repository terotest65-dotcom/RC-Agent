<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/enroll_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enroll_title"
                android:textColor="@color/enroll_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_enroll_switch"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/enroll_type_pin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enroll_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:text="@string/enroll_type_pin"
                    android:textColor="@color/enroll_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/enroll_type_pattern"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enroll_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:text="@string/enroll_type_pattern"
                    android:textColor="@color/enroll_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/enroll_type_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_enroll_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:text="@string/enroll_type_password"
                    android:textColor="@color/enroll_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/enroll_active_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/enroll_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/enroll_secret_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/enroll_secret"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_credential_input"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLength="64"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textAlignment="center"
                    android:textColor="@color/enroll_text"
                    android:textColorHint="@color/enroll_muted"
                    android:textSize="22sp" />

                <CheckBox
                    android:id="@+id/enroll_show"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:text="@string/enroll_show"
                    android:textColor="@color/enroll_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/enroll_pattern_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.acme.rc.device.PatternPadView
                    android:id="@+id/enroll_pattern_pad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/enroll_pattern_sequence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/enroll_pattern_empty"
                    android:textColor="@color/enroll_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/enroll_pattern_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/enroll_pattern_clear"
                    android:textColor="@color/enroll_accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/enroll_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/enroll_error"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/enroll_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/enroll_accent"
                android:text="@string/enroll_save"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
