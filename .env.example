# Server secrets (use long random values in production)
RC_SECRET_KEY=replace-with-openssl-rand-base64-48
RC_ADMIN_PASSWORD=replace-with-a-long-admin-password
RC_DEVICE_TOKEN=replace-with-a-long-shared-device-token

# Public origin for admin WebSocket validation and TLS deployment
RC_PUBLIC_ORIGIN=https://rc.example.com
